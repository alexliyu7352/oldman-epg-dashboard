msgstr "耗時（毫秒）"

#: templates/pages/examples/http/_result.html:25
msgid "Bytes received"
msgstr "已接收位元組數"

#: templates/pages/examples/http/_result.html:32
#: templates/pages/examples/http/_result.html:33
msgid "JSON received from upstream"
msgstr "上游傳回的 JSON"

#: templates/pages/examples/http/_result.html:35
