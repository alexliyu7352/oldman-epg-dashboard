msgstr "現在讓這個會話過期嗎？"

#: templates/pages/examples/session/expiry.html:10
msgid "Expire current Session"
msgstr "使當前會話過期"

#: templates/pages/examples/session/lifecycle.html:6
msgid "Current Session snapshot"
msgstr "當前會話快照"

#: oldman/web/templates/oldman/auth/user_session_content.html:69
#: templates/pages/examples/session/lifecycle.html:10
msgid "Login Time"
msgstr "登入時間"

#: oldman/web/templates/oldman/auth/user_session_content.html:73
#: templates/pages/examples/session/lifecycle.html:11
msgid "Login IP"
msgstr "登入 IP"

#: templates/pages/examples/session/lifecycle.html:12
msgid "Active Session records"
msgstr "活動會話記錄"

#: templates/pages/examples/session/lifecycle.html:17
msgid "Storage boundary"
msgstr "儲存邊界"

#: templates/pages/examples/session/lifecycle.html:19
